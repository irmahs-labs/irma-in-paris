# Copy to .env for local development; nothing here is ever committed. The
# server gets its settings from compose.prod.yaml and GitHub secrets instead.
#
#   npm run db:up        Postgres on localhost:5435, migrations applied
#   npm run storage:up   Garage on localhost:3900, with the photos bucket
#   npm run dev:api      the server on :3002, reading this file
#   npm run dev          the site on :5173, which forwards /api to :3002

# Read by the server.
DATABASE_URL=postgres://irma_in_paris:irma_in_paris@localhost:5435/irma_in_paris
APP_URL=http://localhost:5173
# The IrmaHS Labs account service (irmahs-labs/auth), run locally on :3001.
AUTH_INTERNAL_URL=http://localhost:3001
PORT=3002

# Garage, local only: these are the values compose.yaml's Garage is set up
# with by `npm run storage:up`.
S3_ENDPOINT=http://localhost:3900
S3_BUCKET=photos
S3_ACCESS_KEY_ID=GKe9047e09d786abbf8a82a9da
S3_SECRET_ACCESS_KEY=eb9a7d2c494d5a4f6a531a02af58815e2edd2b57b06f87de52aebb561209c8a9

# Île-de-France Mobilités PRIM (prim.iledefrance-mobilites.fr → My account →
# API key). Without it the transport screen says live times are off; the
# weather and Vélib' need no key.
PRIM_API_KEY=

# Google Maps Platform, with the Places API (New) on: finding restaurants by
# name when adding one. Without it the places show, but none can be added.
GOOGLE_MAPS_API_KEY=

# The map of Paris, from `npm run map:fetch`.
MAP_FILE=maps/paris.pmtiles
